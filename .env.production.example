# =====================================================================
#  SmartBazars — PRODUCTION environment  (copy to .env on the server)
#  Backend / admin / vendor / partner panels + API:  https://a.smartbazars.in
#  Customer website:                                  https://smartbazars.in
# =====================================================================
APP_NAME=SmartBazars
APP_ENV=production
APP_KEY=                       # php artisan key:generate (once, then keep it forever)
APP_DEBUG=false
APP_URL=https://a.smartbazars.in
APP_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://smartbazars.in
CORS_EXTRA_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartbazars
DB_USERNAME=smartbazars_user   # a dedicated MySQL user, not root
DB_PASSWORD=CHANGE_ME_STRONG

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=a.smartbazars.in
SANCTUM_STATEFUL_DOMAINS=a.smartbazars.in

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_CONVERSIONS_BY_DEFAULT=false
FILESYSTEM_DISK=public
MEDIA_DISK=public

DEBUGBAR_ENABLED=false
ALLOW_DEMO_SEED=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@smartbazars.in
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@smartbazars.in
MAIL_FROM_NAME="SmartBazars"

# Optional: real product photos command
PEXELS_API_KEY=
